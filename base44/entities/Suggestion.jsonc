{
  "name": "Suggestion",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "title": "Suggestion"
    },
    "email": {
      "type": "string",
      "title": "Email (optional)"
    }
  },
  "required": [
    "message"
  ],
  "access_control": {
    "list": "admin",
    "get": "admin",
    "create": "public",
    "update": "admin",
    "delete": "admin"
  },
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}