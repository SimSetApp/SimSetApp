{
  "name": "SavedSetup",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Setup Title"
    },
    "sim_title": {
      "type": "string",
      "title": "Sim Title",
      "enum": [
        "iRacing",
        "Assetto Corsa Competizione",
        "Assetto Corsa",
        "Assetto Corsa Evo",
        "Le Mans Ultimate",
        "Automobilista 2",
        "Gran Turismo 7"
      ]
    },
    "car": {
      "type": "string",
      "title": "Car"
    },
    "track": {
      "type": "string",
      "title": "Track"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "parameters": {
      "type": "object",
      "title": "Setup Parameters",
      "additionalProperties": true
    }
  },
  "required": [
    "title",
    "sim_title",
    "car"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}